{
  "common_tests": [
    {
      "name": "Lookup by gene ID",
      "type": "id_lookup",
      "id": "@reference[0].id"
    },
    {
      "name": "Check attributes present",
      "type": "attribute_check",
      "id": "@reference[0].id"
    },
    {
      "name": "Invalid ID handling",
      "type": "invalid_id",
      "invalid_id": "ENSG99999999999"
    }
  ],
  "custom_tests": [
    {
      "name": "hpa gene card lookup (TSPAN6)",
      "type": "dataset_lookup",
      "dataset": "hpa",
      "identifier": "ENSG00000000003",
      "expected_attr": "Hpa",
      "check_field": "gene_name",
      "expected_value": "TSPAN6"
    },
    {
      "name": "hpa antibody lookup",
      "type": "dataset_lookup",
      "dataset": "hpa_antibody",
      "identifier": "HPA004109",
      "expected_attr": "HpaAntibody"
    },
    {
      "name": "hpa subcellular cross-reference to GO",
      "type": "mapping_check",
      "source_id": "ENSG00000000003",
      "source_dataset": "hpa",
      "target_dataset": "go",
      "min_targets": 1
    }
  ]
}
